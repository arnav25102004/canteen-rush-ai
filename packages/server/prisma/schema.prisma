generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum UserRole {
  STUDENT
  FACULTY
  VENDOR
  ADMIN
  SUPER_ADMIN
}

// ============================================================
// INSTITUTION (multi-tenant root)
// ============================================================

model Institution {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  emailDomain String   @map("email_domain")
  logoUrl     String?  @map("logo_url")
  city        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  canteens      Canteen[]
  users         User[]
  announcements Announcement[]
  feedbacks     Feedback[]

  @@map("institutions")
}

model User {
  id               String    @id @default(uuid())
  firebaseUid      String    @unique @map("firebase_uid")
  email            String    @unique
  name             String
  phone            String?
  role             UserRole  @default(STUDENT)
  avatarUrl        String?   @map("avatar_url")
  campus           String?   // "Bannerghatta", "Kengeri", "Central"
  department       String?   // "MCA", "BBA", "BTECH", null for faculty/admin
  dietPreference   String?   @map("diet_preference") // "veg", "nonveg", "jain", "noegg"
  fcmToken         String?   @map("fcm_token")
  institutionId    String?   @map("institution_id")
  orderStrikes     Int       @default(0) @map("order_strikes")
  strikeBannedUntil DateTime? @map("strike_banned_until")
  isBanned         Boolean   @default(false) @map("is_banned")
  banReason        String?   @map("ban_reason")
  bannedAt         DateTime? @map("banned_at")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  institution    Institution?   @relation(fields: [institutionId], references: [id])
  wallet         Wallet?
  orders         Order[]
  ratings        Rating[]
  feedbacks      Feedback[]
  favorites      Favorite[]
  vendorCanteen  Canteen?       @relation("VendorCanteen")
  notifications  Notification[]
  loyaltyAccount LoyaltyAccount?
  assistantConversations AssistantConversation[]
  assistantProposals     AssistantProposal[]
  assistantReports       AssistantReport[]

  @@index([institutionId])
  @@map("users")
}

// ============================================================
// CANTEENS
// ============================================================

model Canteen {
  id            String   @id @default(uuid())
  name          String   // "Mingoes", "Christ Bakery", "Punjabi Bites", "Michael", "Freshetaria"
  description   String?
  campus        String   // "Bannerghatta Road", "Kengeri", "Central City"
  location      String?  // "Block 1, Ground Floor"
  imageUrl      String?  @map("image_url")
  bannerUrl     String?  @map("banner_url")
  isActive      Boolean  @default(true) @map("is_active")
  openingTime   String   @map("opening_time") // "07:30"
  closingTime   String   @map("closing_time") // "20:00"
  contactPhone  String?  @map("contact_phone")
  avgPrepTime   Int      @default(15) @map("avg_prep_time")
  vendorUpiId       String?  @map("vendor_upi_id")        // "punjabibites@oksbi"
  vendorUpiName     String?  @map("vendor_upi_name")       // "Punjabi Bites"
  razorpayAccountId String?  @map("razorpay_account_id")   // "acc_XXXXXXXXXX" from Razorpay Route
  institutionId     String   @map("institution_id")
  ratingSum         Int      @default(0) @map("rating_sum")
  totalRatings      Int      @default(0) @map("total_ratings")
  avgRating         Decimal  @default(0) @db.Decimal(2, 1) @map("avg_rating")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution   Institution       @relation(fields: [institutionId], references: [id])
  vendor        User?             @relation("VendorCanteen", fields: [vendorId], references: [id])
  vendorId      String?           @unique @map("vendor_id")
  categories    MenuCategory[]
  menuItems     MenuItem[]
  pickupSlots   PickupSlot[]
  orders        Order[]
  announcements Announcement[]
  settlements   DailySettlement[]
  ratings       Rating[]
  feedbacks     Feedback[]

  @@index([institutionId])
  @@map("canteens")
}

// ============================================================
// MENU SYSTEM
// ============================================================

model MenuCategory {
  id            String   @id @default(uuid())
  canteenId     String   @map("canteen_id")
  name          String   // "Breakfast", "Lunch", "Snacks", "Beverages"
  description   String?
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  availableFrom String?  @map("available_from") // "07:30"
  availableTo   String?  @map("available_to")   // "10:30"
  createdAt     DateTime @default(now()) @map("created_at")

  canteen Canteen    @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  items   MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String   @id @default(uuid())
  canteenId       String   @map("canteen_id")
  categoryId      String   @map("category_id")
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)                   // app price shown to students
  counterPrice    Decimal? @db.Decimal(10, 2) @map("counter_price") // vendor's actual price; difference is platform fee
  imageUrl        String?  @map("image_url")
  isVeg           Boolean  @default(true) @map("is_veg")
  isJain          Boolean  @default(false) @map("is_jain")
  containsEgg     Boolean  @default(false) @map("contains_egg")
  prepTimeMinutes Int      @default(10) @map("prep_time_minutes")
  isAvailable     Boolean  @default(true) @map("is_available")
  isPopular       Boolean  @default(false) @map("is_popular")
  isNew           Boolean  @default(false) @map("is_new")
  sortOrder       Int      @default(0) @map("sort_order")
  totalOrders     Int      @default(0) @map("total_orders")
  avgRating       Decimal  @default(0) @db.Decimal(2, 1) @map("avg_rating")
  totalRatings    Int      @default(0) @map("total_ratings")
  ratingSum       Int      @default(0) @map("rating_sum")
  customizations  Json?    @default("[]")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  canteen    Canteen      @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  ratings    Rating[]
  favorites  Favorite[]

  @@index([canteenId, categoryId])
  @@index([canteenId, isAvailable])
  @@map("menu_items")
}

// ============================================================
// PICKUP SLOT SYSTEM
// ============================================================

model PickupSlot {
  id              String   @id @default(uuid())
  canteenId       String   @map("canteen_id")
  date            DateTime @db.Date
  startTime       String   @map("start_time") // "09:00"
  endTime         String   @map("end_time")   // "09:15"
  maxOrders       Int      @map("max_orders")
  currentOrders   Int      @default(0) @map("current_orders")
  walkInReserved  Int      @default(5) @map("walk_in_reserved")
  facultyReserved Int      @default(3) @map("faculty_reserved") // slots reserved for faculty priority
  isOpen          Boolean  @default(true) @map("is_open")
  createdAt       DateTime @default(now()) @map("created_at")

  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([canteenId, date, startTime])
  @@index([canteenId, date])
  @@map("pickup_slots")
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  UPI_DIRECT
  WALLET
  CASH
  RAZORPAY
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PENDING_VERIFICATION
  VERIFIED
  PAID
  REFUNDED
  EXPIRED
  FAILED
}

model Order {
  id                  String         @id @default(uuid())
  orderNumber         String         @unique @map("order_number")
  userId              String?        @map("user_id")
  canteenId           String         @map("canteen_id")
  slotId              String?        @map("slot_id")
  status              OrderStatus    @default(PENDING)
  paymentStatus       PaymentStatus  @default(AWAITING_PAYMENT) @map("payment_status")
  paymentMethod       PaymentMethod  @default(UPI_DIRECT) @map("payment_method")
  subtotal            Decimal        @db.Decimal(10, 2)
  platformFee         Decimal        @default(0) @db.Decimal(10, 2) @map("platform_fee")
  discountAmount      Decimal        @default(0) @db.Decimal(10, 2) @map("discount_amount")
  totalAmount         Decimal        @db.Decimal(10, 2) @map("total_amount")
  upiOrderNote        String?        @map("upi_order_note")
  razorpayOrderId     String?        @unique @map("razorpay_order_id")   // "order_XXXXXXXXXX"
  razorpayPaymentId   String?        @unique @map("razorpay_payment_id") // "pay_XXXXXXXXXX"
  razorpayTransferId  String?        @map("razorpay_transfer_id")        // Route transfer ID
  pickupCode          String?        @map("pickup_code")                 // short human-readable e.g. "CR-042"
  qrCode              String?        @map("qr_code")
  qrScanned           Boolean        @default(false) @map("qr_scanned")
  specialInstructions String?        @map("special_instructions")
  estimatedReadyAt    DateTime?      @map("estimated_ready_at")
  actualReadyAt       DateTime?      @map("actual_ready_at")
  pickedUpAt          DateTime?      @map("picked_up_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  cancelReason        String?        @map("cancel_reason")
  paymentClaimedAt    DateTime?      @map("payment_claimed_at")
  paymentVerifiedAt   DateTime?      @map("payment_verified_at")
  bankTransactionId   String?        @map("bank_transaction_id")
  pointsEarned        Int            @default(0) @map("points_earned")
  pointsRedeemed      Int            @default(0) @map("points_redeemed")
  feedbackNudgeAt     DateTime?      @map("feedback_nudge_at")
  feedbackNudgeSentAt DateTime?      @map("feedback_nudge_sent_at")
  feedbackNudge2SentAt DateTime?     @map("feedback_nudge2_sent_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  user              User?              @relation(fields: [userId], references: [id])
  canteen           Canteen            @relation(fields: [canteenId], references: [id])
  slot              PickupSlot?        @relation(fields: [slotId], references: [id])
  items             OrderItem[]
  ratings           Rating[]
  feedbacks         Feedback[]
  walletTransaction WalletTransaction?
  pointTransactions PointTransaction[]

  @@index([userId, createdAt])
  @@index([canteenId, status])
  @@index([canteenId, paymentStatus])
  @@index([canteenId, slotId])
  @@index([qrCode])
  @@index([canteenId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([feedbackNudgeSentAt, feedbackNudgeAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  menuItemId     String  @map("menu_item_id")
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2) @map("unit_price")
  totalPrice     Decimal @db.Decimal(10, 2) @map("total_price")
  customizations Json?   @default("{}")
  notes          String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// WALLET & PAYMENTS
// ============================================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

enum TransactionType {
  RECHARGE
  DEBIT
  REFUND
  CREDIT
}

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String          @map("wallet_id")
  orderId      String?         @unique @map("order_id")
  razorpayPaymentId String?     @unique @map("razorpay_payment_id") // idempotency key for webhook credits
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  balanceAfter Decimal         @db.Decimal(10, 2) @map("balance_after")
  description  String?
  createdAt    DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// ============================================================
// LOYALTY / POINTS
// ============================================================

model LoyaltyAccount {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  totalPoints    Int       @default(0) @map("total_points")
  lifetimePoints Int       @default(0) @map("lifetime_points")
  totalSaved     Decimal   @default(0) @db.Decimal(10, 2) @map("total_saved")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User               @relation(fields: [userId], references: [id])
  transactions PointTransaction[]

  @@map("loyalty_accounts")
}

enum PointTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS
}

model PointTransaction {
  id           String               @id @default(uuid())
  loyaltyId    String               @map("loyalty_id")
  orderId      String?              @map("order_id")
  feedbackId   String?              @unique @map("feedback_id") // one award per review
  helpfulFeedbackId String?         @unique @map("helpful_feedback_id") // one admin "helpful" bonus per review
  type         PointTransactionType
  points       Int
  description  String
  balanceAfter Int                  @map("balance_after")
  expiresAt    DateTime?            @map("expires_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])

  @@index([loyaltyId, createdAt])
  @@map("point_transactions")
}

// ============================================================
// DAILY SETTLEMENT (admin tracking of vendor payouts)
// ============================================================

model DailySettlement {
  id          String    @id @default(uuid())
  canteenId   String    @map("canteen_id")
  date        DateTime  @db.Date
  totalOrders Int       @map("total_orders")
  grossAmount Decimal   @db.Decimal(10, 2) @map("gross_amount")   // total revenue before fee
  platformFee Decimal   @db.Decimal(10, 2) @map("platform_fee")   // 2% Razorpay processing fee
  netAmount   Decimal   @db.Decimal(10, 2) @map("net_amount")     // what vendor receives
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  paidBy      String?   @map("paid_by")                           // admin userId who marked paid
  createdAt   DateTime  @default(now()) @map("created_at")

  canteen Canteen @relation(fields: [canteenId], references: [id])

  @@unique([canteenId, date])
  @@map("daily_settlements")
}

// ============================================================
// RATINGS & FAVORITES
// ============================================================

model Rating {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id") // nulled when the account is deleted; the numbers stay
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  canteenId  String?  @map("canteen_id") // denormalised for aggregates
  feedbackId String?  @map("feedback_id")
  rating     Int      // 1-5
  taste      Int?     // 1-5
  portion    Int?     // 1-5
  value      Int?     // 1-5
  tags       String[] @default([])
  review     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id])
  order    Order     @relation(fields: [orderId], references: [id])
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
  canteen  Canteen?  @relation(fields: [canteenId], references: [id])
  feedback Feedback? @relation(fields: [feedbackId], references: [id])

  @@unique([userId, orderId, menuItemId])
  @@index([menuItemId])
  @@index([canteenId, createdAt])
  @@index([feedbackId])
  @@map("ratings")
}

// ============================================================
// FEEDBACK ("Khana Talk")
// ============================================================

enum FeedbackKind {
  ORDER_REVIEW
  CANTEEN
  APP_BUG
  APP_IDEA
  APP_PRAISE
  APP_OTHER
}

enum FeedbackStatus {
  RECEIVED
  SEEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
  DUPLICATE
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackVisibility {
  ADMIN_ONLY
  VENDOR
  PUBLIC
}

enum FeedbackModeration {
  PENDING
  CLEAN
  FLAGGED
  HIDDEN
}

enum AttachmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A partial unique index lives only in the migration SQL (Prisma cannot express it):
//   feedback_order_review_once ON feedback(order_id) WHERE kind = 'ORDER_REVIEW' AND deleted_at IS NULL
model Feedback {
  id                   String             @id @default(uuid())
  kind                 FeedbackKind
  status               FeedbackStatus     @default(RECEIVED)
  priority             FeedbackPriority   @default(NORMAL)
  visibility           FeedbackVisibility @default(ADMIN_ONLY)
  moderation           FeedbackModeration @default(PENDING)
  userId               String?            @map("user_id") // null once the account is deleted
  institutionId        String?            @map("institution_id")
  orderId              String?            @map("order_id")
  canteenId            String?            @map("canteen_id")
  overallRating        Int?               @map("overall_rating") // 1-5
  tags                 String[]           @default([])
  body                 String?            // raw text, admin only
  bodyRedacted         String?            @map("body_redacted") // PII-redacted text for vendor and public views
  isAnonymous          Boolean            @default(false) @map("is_anonymous")
  shareNameWithCanteen Boolean            @default(false) @map("share_name_with_canteen")
  contextJson          Json?              @map("context_json") // diagnostics, 8 KB max
  clientRequestId      String?            @map("client_request_id")
  assignedTo           String?            @map("assigned_to")
  duplicateOfId        String?            @map("duplicate_of_id")
  changelogEntryId     String?            @map("changelog_entry_id")
  editCount            Int                @default(0) @map("edit_count")
  firstSeenAt          DateTime?          @map("first_seen_at")
  slaDueAt             DateTime?          @map("sla_due_at")
  resolvedAt           DateTime?          @map("resolved_at")
  editedAt             DateTime?          @map("edited_at")
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user           User?                    @relation(fields: [userId], references: [id])
  institution    Institution?             @relation(fields: [institutionId], references: [id])
  order          Order?                   @relation(fields: [orderId], references: [id])
  canteen        Canteen?                 @relation(fields: [canteenId], references: [id])
  changelogEntry ChangelogEntry?          @relation(fields: [changelogEntryId], references: [id])
  ratings        Rating[]
  attachments    FeedbackAttachment[]
  events         FeedbackEvent[]
  reports        FeedbackReport[]
  reveals        FeedbackIdentityReveal[]

  @@unique([userId, clientRequestId])
  @@index([institutionId, status, createdAt])
  @@index([canteenId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([kind, createdAt])
  @@map("feedback")
}

model FeedbackAttachment {
  id         String           @id @default(uuid())
  feedbackId String           @map("feedback_id")
  url        String
  publicId   String?          @map("public_id")
  mimeType   String?          @map("mime_type")
  sizeBytes  Int?             @map("size_bytes")
  status     AttachmentStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_attachments")
}

// Audit trail and timeline. Internal events are never shown to the user or vendor.
model FeedbackEvent {
  id         String          @id @default(uuid())
  feedbackId String          @map("feedback_id")
  actorId    String?         @map("actor_id")
  type       String          // "created", "status_changed", "note", "reply", ...
  fromStatus FeedbackStatus? @map("from_status")
  toStatus   FeedbackStatus? @map("to_status")
  note       String?
  isInternal Boolean         @default(false) @map("is_internal")
  data       Json?
  createdAt  DateTime        @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
  @@map("feedback_events")
}

// Reports of feedback or replies as inappropriate (UGC policy).
model FeedbackReport {
  id         String    @id @default(uuid())
  feedbackId String    @map("feedback_id")
  reporterId String    @map("reporter_id")
  reason     String
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, reporterId])
  @@map("feedback_reports")
}

// "You said, we did"
model ChangelogEntry {
  id            String    @id @default(uuid())
  institutionId String?   @map("institution_id") // null = platform-wide
  canteenId     String?   @map("canteen_id") // set when the change is about one canteen
  title         String
  body          String
  createdBy     String?   @map("created_by")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  feedbacks Feedback[]

  @@index([publishedAt])
  @@map("changelog_entries")
}

// Audit of super-admin reveals of an anonymous sender.
model FeedbackIdentityReveal {
  id         String   @id @default(uuid())
  feedbackId String   @map("feedback_id")
  revealedBy String   @map("revealed_by")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id])

  @@index([feedbackId])
  @@map("feedback_identity_reveals")
}

// One row per CSV export of feedback, written before streaming starts.
model FeedbackExportAudit {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  filtersJson Json     @map("filters_json")
  rowCount    Int      @default(0) @map("row_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@map("feedback_export_audits")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  menuItemId String   @map("menu_item_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
  @@map("favorites")
}

// ============================================================
// NOTIFICATIONS & ANNOUNCEMENTS
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   // "order_update", "promotion", "announcement"
  data      Json?    @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id            String    @id @default(uuid())
  institutionId String?   @map("institution_id") // null = platform-wide
  canteenId     String?   @map("canteen_id")      // null = institution-wide
  title         String
  body          String
  isActive      Boolean   @default(true) @map("is_active")
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id])
  canteen     Canteen?     @relation(fields: [canteenId], references: [id])

  @@map("announcements")
}

// Daily order-number counter (CC-YYYYMMDD-NNNN). Lives in Postgres so order
// numbers stay unique without Redis.
model OrderCounter {
  date String @id // YYYYMMDD, IST
  seq  Int    @default(0)

  @@map("order_counters")
}

// ============================================================
// AI ASSISTANT (keep this block at the end of the file)
// ============================================================

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantProposalStatus {
  PROPOSED
  HANDED_OFF
  SUPERSEDED
  EXPIRED
}

enum AssistantReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model AssistantConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // Short ref -> real id map (c1/m4/s2/p1), capped server-side.
  refs      Json     @default("{}")
  // One turn at a time per conversation: a turn holds the lock until this time.
  busyUntil DateTime? @map("busy_until")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]
  proposals AssistantProposal[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String               @id @default(uuid())
  conversationId String               @map("conversation_id")
  role           AssistantMessageRole
  text           String
  cards          Json?
  chips          Json?
  // Client-generated idempotency key; a replay returns the stored reply.
  clientTurnId   String?              @map("client_turn_id")
  // For an ASSISTANT message: the USER message it answers.
  replyToId      String?              @map("reply_to_id")
  outcome        String?
  reportedAt     DateTime?            @map("reported_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reports      AssistantReport[]

  @@unique([conversationId, clientTurnId, role])
  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("assistant_messages")
}

model AssistantProposal {
  id             String                  @id @default(uuid())
  userId         String                  @map("user_id")
  conversationId String?                 @map("conversation_id")
  canteenId      String                  @map("canteen_id")
  // [{ menuItemId, quantity }] snapshot; prices are re-quoted at hand-off.
  items          Json
  subtotal       Decimal                 @db.Decimal(10, 2)
  slotId         String?                 @map("slot_id")
  status         AssistantProposalStatus @default(PROPOSED)
  expiresAt      DateTime                @map("expires_at")
  handedOffAt    DateTime?               @map("handed_off_at")
  createdAt      DateTime                @default(now()) @map("created_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([conversationId])
  @@index([createdAt])
  @@map("assistant_proposals")
}

// Usage ledger. Holds no message content: hashes and counts only.
model AssistantCallLog {
  id             String   @id @default(uuid())
  // Nulled when the account is deleted.
  userId         String?  @map("user_id")
  conversationId String?  @map("conversation_id")
  kind           String   // "LLM" | "TOOL" | "TURN"
  name           String   // model id or tool name
  status         String   // ok | rate_limited | error | timeout | refused ...
  latencyMs      Int      @default(0) @map("latency_ms")
  promptTokens   Int      @default(0) @map("prompt_tokens")
  completionTokens Int    @default(0) @map("completion_tokens")
  argsSha256     String?  @map("args_sha256")
  groundingDrops Int      @default(0) @map("grounding_drops")
  resultBytes    Int?     @map("result_bytes")
  toolsOffered   Int?     @map("tools_offered")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("assistant_call_logs")
}

// scope: a user id, "global", or "model:<id>"; day is an IST date key (YYYY-MM-DD).
model AssistantDailyUsage {
  scope  String
  day    String
  turns  Int    @default(0)
  tokens Int    @default(0)

  @@id([scope, day])
  @@map("assistant_daily_usage")
}

model AssistantReport {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  messageId String?               @map("message_id")
  reason    String?
  status    AssistantReportStatus @default(OPEN)
  createdAt DateTime              @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  message AssistantMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([messageId])
  @@map("assistant_reports")
}
