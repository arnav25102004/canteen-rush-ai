# Database
DATABASE_URL=postgresql://canteen_user:canteen_pass@localhost:5432/christ_canteen

# Redis (optional cache)
REDIS_URL=redis://localhost:6379

# JWT / QR Tokens — at least 32 chars, server refuses to start otherwise
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_EXPIRES_IN=12h

# Auth
# Comma-separated emails that become ADMIN on first registration. Everyone else
# starts as STUDENT; admins promote vendors from the admin Users page.
ADMIN_EMAILS=admin@christuniversity.in
# Local dev only: enables /api/auth/dev-login and dev.*.mock tokens.
# Ignored when NODE_ENV=production.
DEV_AUTH=false

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# Razorpay (off = pay at counter)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx
